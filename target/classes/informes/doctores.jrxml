<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="doctores" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="LOGO" class="java.net.URL"/>
    <queryString>
        <![CDATA[SELECT iddoc, apeldoc, nomdoc, movildoc, espedoc
                 FROM doctores
                 ORDER BY apeldoc, nomdoc]]>
    </queryString>
    <field name="iddoc" class="java.lang.String"/>
    <field name="apeldoc" class="java.lang.String"/>
    <field name="nomdoc" class="java.lang.String"/>
    <field name="movildoc" class="java.lang.String"/>
    <field name="espedoc" class="java.lang.String"/>
    <title>
        <band height="76">
            <image><reportElement x="52" y="0" width="50" height="50"/><imageExpression><![CDATA[$P{LOGO}]]></imageExpression></image>
            <staticText><reportElement x="200" y="15" width="180" height="30"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><text><![CDATA[LISTADO DOCTORES]]></text></staticText>
        </band>
    </title>
    <pageHeader>
        <band height="26">
            <staticText><reportElement x="10" y="0" width="70" height="20"/><textElement textAlignment="Center"><font isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText>
            <staticText><reportElement x="95" y="0" width="150" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Apellidos]]></text></staticText>
            <staticText><reportElement x="250" y="0" width="130" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Nombre]]></text></staticText>
            <staticText><reportElement x="385" y="0" width="80" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Móvil]]></text></staticText>
            <staticText><reportElement x="470" y="0" width="75" height="20"/><textElement><font isBold="true"/></textElement><text><![CDATA[Especialidad]]></text></staticText>
            <line><reportElement x="0" y="25" width="550" height="1"/></line>
        </band>
    </pageHeader>
    <detail>
        <band height="32">
            <textField><reportElement x="10" y="2" width="70" height="20"/><textFieldExpression><![CDATA[$F{iddoc}]]></textFieldExpression></textField>
            <textField><reportElement x="95" y="2" width="150" height="20"/><textFieldExpression><![CDATA[$F{apeldoc}]]></textFieldExpression></textField>
            <textField><reportElement x="250" y="2" width="130" height="20"/><textFieldExpression><![CDATA[$F{nomdoc}]]></textFieldExpression></textField>
            <textField><reportElement x="385" y="2" width="80" height="20"/><textFieldExpression><![CDATA[$F{movildoc}]]></textFieldExpression></textField>
            <textField><reportElement x="470" y="2" width="75" height="20"/><textFieldExpression><![CDATA[$F{espedoc}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
